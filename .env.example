# Шаблон окружения для compose.yaml. Скопируйте рядом с compose.yaml как .env
# и подставьте реальные значения. Сам .env в git не попадает.
#
#   cp .env.example .env
#
# Раньше этот файл генерировал SSH-шаг в CI. Теперь деплой на сервер не заходит,
# поэтому .env на сервере поддерживается руками.

# --- Postgres: из этих значений контейнер создаёт роль и базу при первом запуске ---
POSTGRES_USER=questly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=questly

# --- Строка подключения приложения ---
# Host обязан совпадать с именем сервиса из compose.yaml, то есть postgres,
# а не localhost: контейнер приложения ходит к базе по сети compose.
# Database/Username/Password должны совпадать с тремя значениями выше.
CONNECTION_STRING=Host=postgres;Port=5432;Database=questly;Username=questly;Password=change-me

# --- JWT ---
# SERVER_KEY — секрет подписи токенов, минимум 32 байта.
SERVER_KEY=change-me-to-a-long-random-secret-at-least-32-bytes
ISSUER=https://questly.example.com
AUDIENCE=https://questly.example.com

# --- Соль для хешей паролей ---
HASH_SALT=change-me

# --- RabbitMQ ---
RABBITMQ_HOSTNAME=rabbitmq
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
